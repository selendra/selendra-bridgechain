# ─── The Solana leg ───────────────────────────────────────────────────────────
# cp .env.example .env, fill it in, then `chmod 600 .env`.

# Its own image — the relayer cannot share the EVM one (zeroize pin conflict).
RELAYER_IMAGE=selendra/bridge-relayer:local
BRIDGE_PULL_POLICY=missing

# The same sign-scope token the EVM validator on this operator's machine uses.
SIG_STORE_VALIDATOR_TOKEN=

# The SAME secp256k1 key as this operator's EVM validator, 0x-prefixed hex.
# One validator set signs for both VMs, so this must be the key whose address is
# in the gates' on-chain validator set.
#
# This file is the only place it can live: solana-relayer has no encrypted-
# keystore option. `chmod 600 .env`, and do not copy it anywhere else.
SOLANA_VALIDATOR_KEY=

RUST_LOG=info
