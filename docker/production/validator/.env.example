# ─── MACHINE 2..N: one validator ──────────────────────────────────────────────
# cp .env.example .env, fill it in, then `chmod 600 .env`.

BRIDGE_IMAGE=selendra/bridge:local
BRIDGE_PULL_POLICY=missing

# The sign-scope token, issued by whoever runs the store machine.
# Today every validator shares one — see README §6 for what a leak of it does
# and does not buy an attacker.
SIG_STORE_VALIDATOR_TOKEN=

# Guards pause/resume/rescan on the operator API.  openssl rand -hex 32
VALIDATOR_API_TOKEN=

# Host-side loopback port for the operator API. Change it if you run two
# validator stacks on one box (which you should not do in production — the
# point of separate validators is separate failure domains).
VALIDATOR_API_PORT=9090

RUST_LOG=info
