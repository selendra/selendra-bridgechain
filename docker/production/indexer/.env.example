# ─── MACHINE 1 (co-located): the indexer ──────────────────────────────────────
# cp .env.example .env, fill it in, then `chmod 600 .env`.

BRIDGE_IMAGE=selendra/bridge:local
BRIDGE_PULL_POLICY=missing

# Co-located mode: `postgres` is the service name on the shared bridge-core
# network. Use the same password you put in store/.env.
DATABASE_URL=postgres://bridge:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/bridge

# Remote mode (only if the indexer runs on its own machine — see the compose
# header). TLS is not optional here:
# DATABASE_URL=postgres://bridge:PASSWORD@store.example.com:5432/bridge?sslmode=verify-full

RUST_LOG=info
