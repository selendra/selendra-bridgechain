# secrets
.env
secrets/*
keystore.json
bundlr_wallet.json

# rust — bare, so it also covers crates/solana-gate/target (built out of workspace)
target

# node
node_modules/
dist/

# foundry
contracts/out
contracts/cache
contracts/broadcast
# deps are vendored by forge install; keep lib out of git
contracts/lib
contracts/fixtures/swap-deploy.env
contracts/fixtures/xswap-*.env

# postgres data dir for the local compose stack
pgdata/

# a runtime store, never source...
data
# ...but the frontend's src/data is real source (formatters/presentation), not a
# runtime store — the bare `data` rule above would otherwise silently drop it.
!frontend/src/data/
!frontend/src/data/**

# generated at runtime by scripts/testing/*.sh
sig-*
.live-*
/.e2e-logs
/.xswap-logs
/.swap-logs
/.refund-e2e-logs
/validator.toml
/validator-p6.toml
/val1-p7.toml
/val2-p7.toml
/val3-p7.toml
/val1-gql.toml
/val2-gql.toml
/keeper.toml
/keeper-p7.toml
/keeper-gql.toml
# generated by scripts/testing/refund-relayer-e2e.sh
/indexer-refund.toml
/keeper-refund.toml
/validator-refund.toml
/validator-state.json
*.json.tmp
*.log

# editors, tooling, OS
.vs/
.idea/*
.cache
.local
.claude
.playwright-mcp
.DS_Store
heap_info.json
